import os

RAGTAG_REF = config['ragtag_ref']
GENOTYPES  = list(config['genotypes'].keys())

GENOTYPE_SAMPLES = {}
for gt in GENOTYPES:
    wc = glob_wildcards(config['genotypes'][gt]['pacbio_dir'] + "/{sample}.bam")
    GENOTYPE_SAMPLES[gt] = wc.sample


def get_bam(wildcards):
    pacbio_dir = config['genotypes'][wildcards.genotype]['pacbio_dir']
    return os.path.join(pacbio_dir, f"{wildcards.sample}.bam")


def get_filtered_fastqs(wildcards):
    return expand(
        "results/{genotype}/hifiadapterfilt/{sample}.filt.fastq.gz",
        genotype=wildcards.genotype,
        sample=GENOTYPE_SAMPLES[wildcards.genotype],
    )


onstart:
    shell("mkdir -p logs/slurm")


rule all:
    input:
        expand("results/{genotype}.ragtag.scaffold.fa", genotype=GENOTYPES),
        expand("results/plots/{genotype}_ragtag_alignment_coverage.png", genotype=GENOTYPES),


rule hifiadapterfilt:
    input:
        get_bam,
    output:
        fastq="results/{genotype}/hifiadapterfilt/{sample}.filt.fastq.gz",
        stats="results/{genotype}/hifiadapterfilt/{sample}.stats",
        blast="results/{genotype}/hifiadapterfilt/{sample}.contaminant.blastout",
    params:
        outdir="results/{genotype}/hifiadapterfilt",
    log:
        "logs/hifiadapterfilt/{genotype}/{sample}.log",
    threads: 12
    resources:
        mem_mb=16000,
        runtime=480,
        partition="atlas",
    shell:
        "HiFiAdapterFilt.sh -b {input} -p {threads} -o {params.outdir} 2> {log}"


rule assemble_contigs:
    input:
        get_filtered_fastqs,
    output:
        "results/{genotype}/hifiasm/hifiasm.asm.bp.p_ctg.gfa",
    params:
        prefix="results/{genotype}/hifiasm/hifiasm.asm",
    log:
        "logs/assemble_contigs/{genotype}.log",
    threads: 48
    resources:
        mem_mb=1536000,
        runtime=10080,
        partition="bigmem",
    shell:
        "hifiasm -t {threads} -l0 -i -f38 -o {params.prefix} {input} 2> {log}"


rule gfa_to_fasta:
    input:
        "results/{genotype}/hifiasm/hifiasm.asm.bp.p_ctg.gfa",
    output:
        "results/{genotype}/hifiasm/hifiasm.asm.bp.p_ctg.fa",
    log:
        "logs/gfa_to_fasta/{genotype}.log",
    threads: 1
    resources:
        mem_mb=8000,
        runtime=120,
    shell:
        r"""
        awk '/^S/{{print ">"$2"\n"$3}}' {input} > {output} 2> {log}
        """


localrules: approve_cutoffs


rule map_reads_for_purge:
    input:
        assembly="results/{genotype}/hifiasm/hifiasm.asm.bp.p_ctg.fa",
        reads=get_filtered_fastqs,
    output:
        paf="results/{genotype}/purge_dups/aln.paf.gz",
    log:
        "logs/purge_dups/{genotype}_map_reads.log",
    threads: 48
    resources:
        mem_mb=512000,
        runtime=2880,
        partition="bigmem",
    shell:
        "minimap2 -t {threads} -xmap-hifi {input.assembly} {input.reads} 2> {log} "
        "| gzip -c > {output.paf}"


rule calc_coverage_cutoffs:
    input:
        paf="results/{genotype}/purge_dups/aln.paf.gz",
    output:
        stat="results/{genotype}/purge_dups/PB.stat",
        cov="results/{genotype}/purge_dups/PB.base.cov",
        cutoffs="results/{genotype}/purge_dups/cutoffs",
        hist="results/{genotype}/purge_dups/PB.cov.hist.png",
    params:
        outdir="results/{genotype}/purge_dups",
    log:
        "logs/purge_dups/{genotype}_calc_cutoffs.log",
    threads: 1
    resources:
        mem_mb=16000,
        runtime=120,
    shell:
        """
        LOG=$(realpath {log})
        cd {params.outdir}
        pbcstat aln.paf.gz 2> "$LOG"
        calcuts PB.stat > cutoffs 2>> "$LOG"
        hist_plot.py -c cutoffs PB.stat PB.cov.hist.png 2>> "$LOG"
        """


rule self_align_assembly:
    input:
        assembly="results/{genotype}/hifiasm/hifiasm.asm.bp.p_ctg.fa",
    output:
        split=temp("results/{genotype}/purge_dups/assembly.split"),
        paf="results/{genotype}/purge_dups/self.paf.gz",
    log:
        "logs/purge_dups/{genotype}_self_align.log",
    threads: 48
    resources:
        mem_mb=512000,
        runtime=2880,
        partition="bigmem",
    shell:
        """
        split_fa {input.assembly} > {output.split} 2> {log}
        minimap2 -t {threads} -xasm5 -DP {output.split} {output.split} 2>> {log} \
            | gzip -c > {output.paf}
        """


rule approve_cutoffs:
    input:
        hist="results/{genotype}/purge_dups/PB.cov.hist.png",
    output:
        "results/{genotype}/purge_dups/.cutoffs_approved",
    shell:
        """
        echo "=== MANUAL STEP REQUIRED ==="
        echo "Inspect: {input.hist}"
        echo "Optionally edit: results/{wildcards.genotype}/purge_dups/cutoffs"
        echo "Then run: touch {output}"
        echo "Then re-run Snakemake to continue."
        exit 1
        """


rule identify_haplotigs:
    input:
        cov="results/{genotype}/purge_dups/PB.base.cov",
        cutoffs="results/{genotype}/purge_dups/cutoffs",
        self_paf="results/{genotype}/purge_dups/self.paf.gz",
        approved="results/{genotype}/purge_dups/.cutoffs_approved",
    output:
        dups="results/{genotype}/purge_dups/dups.bed",
    params:
        outdir="results/{genotype}/purge_dups",
    log:
        "logs/purge_dups/{genotype}_identify_haplotigs.log",
    threads: 1
    resources:
        mem_mb=16000,
        runtime=120,
    shell:
        """
        LOG=$(realpath {log})
        cd {params.outdir}
        purge_dups -2 -T cutoffs -c PB.base.cov self.paf.gz > dups.bed 2> "$LOG"
        """


rule extract_purged_seqs:
    input:
        dups="results/{genotype}/purge_dups/dups.bed",
        assembly="results/{genotype}/hifiasm/hifiasm.asm.bp.p_ctg.fa",
    output:
        purged="results/{genotype}/purge_dups/purged.fa",
        hap="results/{genotype}/purge_dups/hap.fa",
    params:
        outdir="results/{genotype}/purge_dups",
    log:
        "logs/purge_dups/{genotype}_extract_purged.log",
    threads: 1
    resources:
        mem_mb=16000,
        runtime=120,
    shell:
        """
        LOG=$(realpath {log})
        ASM=$(realpath {input.assembly})
        cd {params.outdir}
        get_seqs -e dups.bed "$ASM" 2> "$LOG"
        """

rule scaffold_contigs:
    input:
        contigs="results/{genotype}/purge_dups/purged.fa",
        ref=RAGTAG_REF,
    output:
        multiext(
            "results/{genotype}/ragtag/ragtag.scaffold",
            ".agp",
            ".asm.paf",
            ".asm.paf.log",
            ".confidence.txt",
            ".err",
            ".fasta",
            ".stats",
        ),
    params:
        outdir="results/{genotype}/ragtag",
    log:
        "logs/scaffold_contigs/{genotype}.log",
    threads: 48
    resources:
        mem_mb=250000,
        runtime=2880,
        partition="bigmem",
    shell:
        "ragtag.py scaffold --mm2-params '-I 200g -x asm5' -t {threads} "
        "-o {params.outdir} {input.ref} {input.contigs} 2> {log}"


rule rename_assembly:
    input:
        "results/{genotype}/ragtag/ragtag.scaffold.fasta",
    output:
        "results/{genotype}.ragtag.scaffold.fa",
    resources:
        mem_mb=4000,
        runtime=30,
        partition="atlas",
    shell:
        "cp {input} {output}"


rule plot_coverage:
    input:
        paf="results/{genotype}/ragtag/ragtag.scaffold.asm.paf",
    output:
        pdf="results/plots/{genotype}_ragtag_alignment_coverage.pdf",
        png="results/plots/{genotype}_ragtag_alignment_coverage.png",
        tsv="results/plots/{genotype}_ragtag_alignment_coverage.tsv",
    params:
        prefix="results/plots/{genotype}_ragtag_alignment",
    log:
        "logs/plot_coverage/{genotype}.log",
    resources:
        mem_mb=16000,
        runtime=60,
        partition="atlas",
    shell:
        "Rscript workflow/scripts/plot_paf_coverage.R {input.paf} {params.prefix} 2> {log}"
