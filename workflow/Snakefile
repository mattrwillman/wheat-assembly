import os

RAGTAG_REF = config['ragtag_ref']
GENOTYPES  = list(config['genotypes'].keys())

GENOTYPE_SAMPLES = {}
for gt in GENOTYPES:
    wc = glob_wildcards(config['genotypes'][gt]['pacbio_dir'] + "/{sample}.bam")
    GENOTYPE_SAMPLES[gt] = wc.sample


def get_bam(wildcards):
    pacbio_dir = config['genotypes'][wildcards.genotype]['pacbio_dir']
    return os.path.join(pacbio_dir, f"{wildcards.sample}.bam")


def get_trimmed_fastqs(wildcards):
    return expand(
        "results/{genotype}/trimmed_filtered/{sample}.fastq",
        genotype=wildcards.genotype,
        sample=GENOTYPE_SAMPLES[wildcards.genotype],
    )


onstart:
    shell("mkdir -p logs/slurm")


rule all:
    input:
        expand("results/{genotype}.ragtag.scaffold.fa", genotype=GENOTYPES),
        expand("results/plots/{genotype}_ragtag_alignment_coverage.png", genotype=GENOTYPES),


rule bam_to_fastq:
    input:
        get_bam,
    output:
        "results/{genotype}/fastq/{sample}.fastq.gz",
    params:
        outprefix="results/{genotype}/fastq/{sample}",
    log:
        "logs/bam_to_fastq/{genotype}/{sample}.log",
    threads: 12
    resources:
        mem_mb=16000,
        runtime=240,
        partition="atlas",
    shell:
        "bam2fastq -j {threads} -c 1 -o {params.outprefix} {input} 2> {log}"


rule filter_adapter:
    input:
        "results/{genotype}/fastq/{sample}.fastq.gz",
    output:
        "results/{genotype}/filtered/{sample}.fastq",
    log:
        "logs/filter_adapter/{genotype}/{sample}.log",
    threads: 12
    resources:
        mem_mb=16000,
        runtime=480,
        partition="atlas",
    shell:
        """
        cutadapt -j {threads} --revcomp -e 0.1 --discard-trimmed \
            -b "AAAAAAAAAAAAAAAAAATTAACGGAGGAGGAGGA;min_overlap=34" \
            -b "ATCTCTCTCTTTTCCTCCTCCTCCGTTGTTGTTGTTGAGAGAGAT;min_overlap=40" \
            {input} > {output} 2> {log}
        """


rule trim_adapter:
    input:
        "results/{genotype}/filtered/{sample}.fastq",
    output:
        "results/{genotype}/trimmed_filtered/{sample}.fastq",
    log:
        "logs/trim_adapter/{genotype}/{sample}.log",
    threads: 12
    resources:
        mem_mb=16000,
        runtime=480,
        partition="atlas",
    shell:
        """
        cutadapt -j {threads} --revcomp -e 0.1 \
            -a "AAAAAAAAAAAAAAAAAATTAACGGAGGAGGAGGA;min_overlap=16" \
            -g "AAAAAAAAAAAAAAAAAATTAACGGAGGAGGAGGA;min_overlap=16" \
            -a "ATCTCTCTCTTTTCCTCCTCCTCCGTTGTTGTTGTTGAGAGAGAT;min_overlap=16" \
            -g "ATCTCTCTCTTTTCCTCCTCCTCCGTTGTTGTTGTTGAGAGAGAT;min_overlap=16" \
            {input} > {output} 2> {log}
        """


rule assemble_contigs:
    input:
        get_trimmed_fastqs,
    output:
        "results/{genotype}/hifiasm/hifiasm.asm.bp.p_ctg.gfa",
    params:
        prefix="results/{genotype}/hifiasm/hifiasm.asm",
    log:
        "logs/assemble_contigs/{genotype}.log",
    threads: 48
    resources:
        mem_mb=1536000,
        runtime=10080,
        partition="bigmem",
    shell:
        "hifiasm -t {threads} -l0 -i -f38 -o {params.prefix} {input} 2> {log}"


rule gfa_to_fasta:
    input:
        "results/{genotype}/hifiasm/hifiasm.asm.bp.p_ctg.gfa",
    output:
        "results/{genotype}/hifiasm/hifiasm.asm.bp.p_ctg.fa",
    log:
        "logs/gfa_to_fasta/{genotype}.log",
    threads: 1
    resources:
        mem_mb=8000,
        runtime=120,
    shell:
        r"""
        awk '/^S/{{print ">"$2"\n"$3}}' {input} > {output} 2> {log}
        """


rule purge_dups:
    input:
        assembly="results/{genotype}/hifiasm/hifiasm.asm.bp.p_ctg.fa",
        reads=get_trimmed_fastqs,
    output:
        purged="results/{genotype}/purge_dups/purged.fa",
        haplotigs="results/{genotype}/purge_dups/hap.fa",
        cutoffs="results/{genotype}/purge_dups/cutoffs",
        hist="results/{genotype}/purge_dups/PB.cov.hist.png",
        stat="results/{genotype}/purge_dups/PB.stat",
    params:
        outdir="results/{genotype}/purge_dups",
    log:
        "logs/purge_dups/{genotype}.log",
    threads: 48
    resources:
        mem_mb=512000,
        runtime=4320,
        partition="bigmem",
    shell:
        r"""
        ASM=$(realpath {input.assembly})
        LOG=$(realpath {log})
        READS=$(for f in {input.reads}; do realpath $f; done | tr '\n' ' ')
        mkdir -p {params.outdir}
        cd {params.outdir}

        # 1. Map HiFi reads to assembly
        minimap2 -t {threads} -xmap-hifi "$ASM" $READS 2>> "$LOG" \
            | gzip -c > aln.paf.gz

        # 2. Coverage stats + auto cutoffs
        pbcstat aln.paf.gz 2>> "$LOG"
        calcuts PB.stat > cutoffs 2>> "$LOG"
        hist_plot.py -c cutoffs PB.stat PB.cov.hist.png 2>> "$LOG"

        # 3. Self-alignment
        split_fa "$ASM" > assembly.split 2>> "$LOG"
        minimap2 -t {threads} -xasm5 -DP assembly.split assembly.split 2>> "$LOG" \
            | gzip -c > self.paf.gz

        # 4. Identify haplotigs
        purge_dups -2 -T cutoffs -c PB.base.cov self.paf.gz > dups.bed 2>> "$LOG"

        # 5. Extract purged primary + haplotig sequences
        get_seqs -e dups.bed "$ASM" 2>> "$LOG"
        """

rule scaffold_contigs:
    input:
        contigs="results/{genotype}/hifiasm/hifiasm.asm.bp.p_ctg.fasta",
        ref=RAGTAG_REF,
    output:
        multiext(
            "results/{genotype}/ragtag/ragtag.scaffold",
            ".agp",
            ".asm.paf",
            ".asm.paf.log",
            ".confidence.txt",
            ".err",
            ".fasta",
            ".stats",
        ),
    params:
        outdir="results/{genotype}/ragtag",
    log:
        "logs/scaffold_contigs/{genotype}.log",
    threads: 48
    resources:
        mem_mb=250000,
        runtime=2880,
        partition="bigmem",
    shell:
        "ragtag.py scaffold --mm2-params '-I 200g -x asm5' -t {threads} "
        "-o {params.outdir} {input.ref} {input.contigs} 2> {log}"


rule rename_assembly:
    input:
        "results/{genotype}/ragtag/ragtag.scaffold.fasta",
    output:
        "results/{genotype}.ragtag.scaffold.fa",
    resources:
        mem_mb=4000,
        runtime=30,
        partition="atlas",
    shell:
        "cp {input} {output}"


rule plot_coverage:
    input:
        paf="results/{genotype}/ragtag/ragtag.scaffold.asm.paf",
    output:
        pdf="results/plots/{genotype}_ragtag_alignment_coverage.pdf",
        png="results/plots/{genotype}_ragtag_alignment_coverage.png",
        tsv="results/plots/{genotype}_ragtag_alignment_coverage.tsv",
    params:
        prefix="results/plots/{genotype}_ragtag_alignment",
    log:
        "logs/plot_coverage/{genotype}.log",
    resources:
        mem_mb=16000,
        runtime=60,
        partition="atlas",
    shell:
        "Rscript workflow/scripts/plot_paf_coverage.R {input.paf} {params.prefix} 2> {log}"
